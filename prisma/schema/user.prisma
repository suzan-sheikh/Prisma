model User {
  id           String        @id @default(uuid())
  name         String        @db.VarChar(255)
  email        String        @unique
  password     String
  activeStatus Active_status @default(ACTIVE)
  role         Role          @default(USER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @default(now())
  profile      Profile?
  post         Post[]
  comments     Comment[]

  @@map("users")
}
